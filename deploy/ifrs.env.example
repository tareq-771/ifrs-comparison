# Phase 5A — قالب بيئة الإنتاج (artifact داخل Git — بلا أي قيم أسرار حقيقية).
#
# الوجهة الفعلية في 5B: /etc/ifrs-comparison/ifrs.env — المالك root:ifrsapp —
# الصلاحيات 0640. يُولَّد NEXTAUTH_SECRET مرة واحدة:
#   openssl rand -base64 48
# لا يُطبع، لا يدخل Git، تؤخذ نسخة مشفرة off-device + مظروف ورقي (وثيقة التصميم §7).

# ── القاعدة (دائمة — خارج شجرة النشر) ──
DATABASE_URL=file:/var/lib/ifrs-comparison/db/custom.db

# ── الحالة التشغيلية الدائمة (epoch / maintenance / recovery / staging) ──
VAR_DIR=/var/lib/ifrs-comparison

# ── النسخ المحلية الدائمة ──
BACKUP_DIR=/var/backups/ifrs-comparison

# ── المصادقة ──
# مطلوب، ≥32 بايت، لا placeholder. مفقود/ضعيف ⇒ رفض الإقلاع (fail-closed).
NEXTAUTH_SECRET=<GENERATED_ONCE openssl rand -base64 48>
# hostname ثابت (R5 — يُحدد في 5B)
NEXTAUTH_URL=https://<HOSTNAME>

# ── التشغيل ──
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# ── محرك الاستعادة (سياسة التصميم المعتمدة: =1 دائمًا في الإنتاج) ──
# مطلوب صريحًا ("0" أو "1") — الغياب ⇒ رفض الإقلاع.
RESTORE_ENGINE_ENABLED=1

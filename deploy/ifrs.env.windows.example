# Phase 5B.1 — قالب بيئة الإنتاج Windows (artifact داخل Git — بلا أي قيم حقيقية).
#
# الوجهة الفعلية في 5B.2: D:\IFRS-Data\config\ifrs.env
# ACL: SYSTEM + Administrators = Full · ifrs-svc = Read فقط.
# NEXTAUTH_SECRET يُولَّد مرة واحدة على جهاز Windows حصرًا (5B.2):
#   PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
# لا يُطبع، لا يدخل Git، لا يدخل أي ZIP نسخ (ALLOWED_ZIP_ENTRIES تمنع بنيويًا)،
# نسخة مشفرة off-device + ظرف ورقي (escrow) لاحقًا.
#
# يُحمَّل بواسطة scripts/prod-server.mjs عبر IFRS_ENV_FILE (تحليل صارم KEY=VALUE).

# ── القاعدة (دائمة — خارج شجرة النشر، NTFS محلي حصرًا) ──
DATABASE_URL=file:D:/IFRS-Data/db/ifrs-prod.db

# ── الحالة التشغيلية الدائمة (epoch / maintenance / recovery / staging) ──
VAR_DIR=D:\IFRS-Data

# ── النسخ المحلية الدائمة (Tier-1 — لا تكفي وحدها كـDisaster Recovery) ──
BACKUP_DIR=D:\IFRS-Backups

# ── أدوات النشر Prisma CLI (Layer B — مثبتة مرة على المضيف، بنفس إصدار @prisma/client) ──
PRISMA_CLI_HOME=C:\Apps\ifrs-comparison\tools\prisma-cli

# ── المصادقة ──
# مطلوب، ≥32 بايت، لا placeholder. مفقود/ضعيف ⇒ رفض الإقلاع (fail-closed).
NEXTAUTH_SECRET=<GENERATED-ONCE-ON-HOST-48-BYTES-BASE64>
# placeholder إلزامي — الاسم النهائي يعتمد في 5B.2 بعد فحص DNS/router/client trust
NEXTAUTH_URL=https://<production-hostname>

# ── التشغيل (ربط loopback حصري — لا LAN على 3000 أبدًا) ──
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# ── محرك الاستعادة (قرار 5B.2 — لا قيمة نهائية في Git) ──
# مطلوب صريحًا ("0" أو "1") — الغياب ⇒ رفض الإقلاع. restoreDatabase تبقى
# صلاحية مستقلة صريحة لا تُمنح ضمنيًا للـadmin مهما كانت القيمة.
RESTORE_ENGINE_ENABLED=<0-or-1>

# ── بوابة الإعداد الأولي (bootstrap) ──
# تُضبط =1 فقط خلال جلسة الإعداد الأولي (5B.3) ثم تُزال فورًا. بعد أول مدير
# النهاية ميتة بنيويًا (صفر مستخدمين) حتى لو نُسي العلم.
SETUP_BOOTSTRAP_ENABLED=<remove-after-bootstrap>

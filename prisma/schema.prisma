// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Users & Authentication ──
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String   @default("")
  role         String   @default("user") // "admin" | "user"
  // Permissions stored as JSON string
  permissions  String   @default("{}")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  groups       Group[]
  reports      Report[]
}

// ── Report Groups / Company Workspaces ──
model Group {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  reports     Report[]
}

// ── Saved comparison reports (full sessions) ──
model Report {
  id          String   @id @default(cuid())
  name        String
  label1      String   @default("")
  label2      String   @default("")
  compareMode String   @default("period")
  numMonths   Int      @default(12)

  // IS settings (JSON)
  isSettings  String   @default("{}")

  // BS settings (JSON)
  bsSettings  String   @default("{}")

  // IS file 1 data (JSON — accounts array)
  isFile1Data String   @default("[]")
  // IS file 2 data (JSON)
  isFile2Data String   @default("[]")
  // IS file 1 headers (JSON)
  isFile1Headers String @default("[]")
  // IS file 2 headers (JSON)
  isFile2Headers String @default("[]")
  // IS file 1 column mapping (JSON)
  isFile1Cols String   @default("{}")
  // IS file 2 column mapping (JSON)
  isFile2Cols String   @default("{}")

  // BS file data (JSON — accounts array)
  bsFileData  String   @default("[]")
  // BS file headers (JSON)
  bsFileHeaders String @default("[]")
  // BS file column mapping (JSON)
  bsFileCols  String   @default("{}")

  // BS file 2 data (JSON — for period mode with 2 BS files)
  bsFile2Data  String   @default("[]")
  bsFile2Headers String @default("[]")
  bsFile2Cols  String   @default("{}")

  // ── Phase 6.1 — ربط الأساس المالي (حقول إضافية nullable بحتة — لا تكسر أي تدفق قديم) ──
  // الشركة المرتبطة (nullable = تقرير غير مربوط بعد — backfillStatus يوضح السبب).
  // Restrict عمدًا: وجود تقرير مرتبط يمنع حذف الشركة (لا SetNull ولا Cascade —
  // التاريخ المالي لا يُفقد بصمت).
  companyId       String?
  company         Company?        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // الفترة المحاسبية المرتبطة (نهاية الفترة المالية periodEnd تقع ضمنها)
  fiscalPeriodId  String?
  fiscalPeriod    FiscalPeriod?   @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  // حالة الربط الخلفي (backfill): MAPPED | NO_PERIOD | NO_COMPANY | PENDING — null = قبل تشغيل الأداة
  backfillStatus  String?

  // Group association (nullable — reports without a group are "ungrouped")
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)

  // Optimistic locking: يزيد 1 مع كل تحديث ناجح (PUT). العميل يرسل النسخة التي
  // فتحها، ويرفض الخادم التحديث بـ 409 VERSION_CONFLICT إذا تغيرت في الخادم.
  version     Int      @default(1)

  // ── Workflow & Governance (المرحلة 3) — تمثل دورة الاعتماد الحالية فقط ──
  // السجل التاريخي الكامل للدورات في WorkflowHistory (append-only).
  // بلا FK علاقات مع User عمدًا (نفس مبرر AuditLog): حذف المستخدم لا يمس الأدوار
  // الرقابية، والأسماء محفوظة كـ snapshot في حقول *ByName.
  // المرحلة 3.5: +PENDING_APPROVAL — DRAFT→SUBMITTED→UNDER_REVIEW→PENDING_APPROVAL→APPROVED
  status          String    @default("DRAFT")   // DRAFT | SUBMITTED | UNDER_REVIEW | PENDING_APPROVAL | RETURNED | APPROVED | REOPENED
  periodEnd       String?                       // نهاية الفترة المالية — نص date-only "YYYY-MM-DD" (بلا انزياح timezone)
  cycle           Int       @default(1)         // رقم دورة الاعتماد الحالية (يزيد 1 مع كل REOPEN فقط)

  // المرحلة 3.5 — تاريخ استحقاق المطابقة (حقل رقابي контролد:
  // يُضبط عند الإنشاء/عبر مسار الحوكمة assignWorkflow فقط — لا عبر تعديل المعدّ المعتاد).
  // نص date-only "YYYY-MM-DD" — null = «غير محدد» ولا يُختلق له تاريخ إطلاقًا.
  dueDate         String?

  preparedById    String?                       // المعدّ (يُثبت عند الإنشاء/الإسناد)
  preparedByName  String    @default("")        // snapshot للاسم
  preparedAt      DateTime?                     // يُثبت عند أول SUBMIT (اكتمال الإعداد) — لا عند الإنشاء

  reviewedById    String?                       // المراجع (معيّن قبل SUBMIT)
  reviewedByName  String    @default("")
  // المرحلة 3.5 — فصل دلالتي البدء والإتمام (لا تغيير دلالة صامت):
  //   reviewStartedAt = وقت START_REVIEW  (مهاجرة من reviewedAt القديم بدلالة «البدء»)
  //   reviewedAt      = وقت COMPLETE_REVIEW (توقيع المراجع وانتقال إلى PENDING_APPROVAL)
  reviewStartedAt DateTime?                     // تاريخ بدء المراجعة (يُثبت عند START_REVIEW)
  reviewedAt      DateTime?                     // تاريخ إتمام المراجعة/توقيع المراجع (يُثبت عند COMPLETE_REVIEW)

  approvedById    String?                       // المعتمد
  approvedByName  String    @default("")
  approvedAt      DateTime?                     // يُثبت عند APPROVE ويُمسح عند REOPEN (بعد أرشفته في WorkflowHistory)

  returnedById    String?                       // من أرجع التقرير
  returnedByName  String    @default("")
  returnedAt      DateTime?
  returnReason    String    @default("")        // إلزامي عند RETURN — يُمسح عند إعادة الإرسال (الأصل في التاريخ)

  reopenedById    String?                       // من أعاد الفتح
  reopenedByName  String    @default("")
  reopenedAt      DateTime?
  reopenReason    String    @default("")        // إلزامي عند REOPEN — يُمسح عند إعادة الإرسال (الأصل في التاريخ)

  // User who created the report
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([preparedById])
  @@index([reviewedById])
  @@index([approvedById])
  // فهارس لوحة المتابعة (المرحلة 3.5) — تُدقّق مقابل Query Plans فعلية وقد تُقلّص بعد القياس
  @@index([periodEnd])
  @@index([dueDate])
  @@index([updatedAt])
  @@index([cycle])
  @@index([groupId, status])
  // فهارس الأساس المالي (6.1)
  @@index([companyId])
  @@index([fiscalPeriodId])
  @@index([backfillStatus])
}

// ── Phase 6.1 — كيان الشركة (الأساس المالي) ──────────────────────────────────
// الهوية الآلية = code (وحيد) — الأسماء المعروضة (nameAr/nameEn) توصيف فقط ولا
// تُستخدم مفاتيح هوية أبدًا (قرار 6.0A: فصل الهوية الآلية عن التسمية المعروضة).
// العملة ISO-4217-ready (سجل عملات موسّع في src/lib/currencies.ts) — nullable
// حتى أول استخدام مالي؛ لا تحويل عملات ولا ترجمة ولا توحيد في 6.1.
// الحذف الصلب: شركة غير مستخدمة تمامًا فقط (لا تقارير/سنوات/سياسة/ربط legacy) —
// وإلا فالسياسة هي التعطيل INACTIVE مع بقاء الرؤية التاريخية.
model Company {
  id                 String   @id @default(cuid())
  code               String   @unique            // هوية آلية وحيدة (لا أسماء محلية)
  nameAr             String                      // الاسم المعروض بالعربية (إلزامي)
  nameEn             String   @default("")       // الاسم المعروض بالإنجليزية (اختياري)
  status             String   @default("ACTIVE") // ACTIVE | INACTIVE — إبطال يحفظ الرؤية التاريخية
  functionalCurrency String   @default("")       // ISO-4217 (YER/SAR/USD...) — "" = غير محددة بعد
  reportingCurrency  String   @default("")       // ISO-4217 — افتراضيًا تُشتق من الوظيفية عند الضبط
  notes              String   @default("")
  // ربط حتمي ثابت بمجموعة العمل القديمة (backfill 6.1) — يضمن عدم تكرار الشركات
  // عند إعادة تشغيل أداة الربط مهما فُقدت ملفات VAR_DIR (المصدر = قاعدة البيانات).
  legacyGroupId      String?  @unique

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  fiscalYears        FiscalYear[]
  closingPolicy      CompanyClosingPolicy?
  reports            Report[]

  // ── Phase 6.2 back-relations ──
  accountNatureRules   AccountNatureRule[]
  accountMappingOverrides AccountMappingOverride[]
  trialBalanceImports  TrialBalanceImport[]

  // ── Phase 6.4 back-relations ──
  equityComponentMappings  EquityComponentMapping[]
  cashFlowMappings         CashFlowMapping[]
  cashFlowAccountOverrides CashFlowAccountOverride[]

  // ── Phase 6.5 back-relations ──
  budgets                  Budget[]

  // ── Phase 6.6 back-relations ──
  groupMemberships         GroupCompanyMembership[]
  groupLineMappings        GroupReportingMapping[]

  // ── Phase 6.10 back-relations ──
  agingBucketConfigs         AgingBucketConfig[]
  agingInsightRules          AgingInsightRule[]
  receivablesAccountMappings ReceivablesAccountMapping[]
  agingImports               AgingImport[]
  agingSnapshots             AgingSnapshot[]

  @@index([status])
  @@index([legacyGroupId])
}

// ── Phase 6.1 — السنة المالية ────────────────────────────────────────────────
// لا افتراض سنوات ميلادية ولا افتراض 12 فترة (سنوات انتقالية/قصيرة مدعومة) —
// تغطية الفترات تُولّد وتُتحقق في الخدمة (src/lib/fiscal-year.ts).
// onDelete Restrict: سنة لها فترات (أو تقارير مرتبطة عبر الفترات) لا تُحذف تتابعيًا.
model FiscalYear {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  code           String                       // هوية آلية داخل الشركة (وحيد لكل شركة)
  displayNameAr  String   @default("")        // عرض فقط — ليس هوية
  displayNameEn  String   @default("")
  startDate      String                       // date-only "YYYY-MM-DD" (نمط المشروع — بلا timezone)
  endDate        String                       // date-only
  periodCount    Int                          // عدد الفترات المولّدة فعليًا (1..24 — لا افتراض 12)
  status         String   @default("OPEN")    // OPEN | CLOSED | LOCKED — انتقالات مُتحقق منها خادميًا
  origin         String   @default("USER_CREATED") // USER_CREATED | PROVISIONAL_IMPORTED (حاويات استيراد مؤقتة تتطلب تأكيد المدير)
  confirmedAt    DateTime?                    // تأكيد الحاوية المؤقتة
  confirmedByName String  @default("")

  // snapshots المنفذين للإغلاق/القفل/إعادة الفتح (نمط Workflow المحلي)
  closedById      String?
  closedByName    String  @default("")
  closedAt        DateTime?
  lockedById      String?
  lockedByName    String  @default("")
  lockedAt        DateTime?
  reopenedById    String?
  reopenedByName  String  @default("")
  reopenedAt      DateTime?
  reopenReason    String  @default("")        // إلزامي عند إعادة الفتح (REOPEN)
  unlockReason    String  @default("")        // إلزامي عند فك القفل (UNLOCK)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  periods        FiscalPeriod[]
  trialBalanceImports TrialBalanceImport[]
  budgets        Budget[]

  @@unique([companyId, code])
  @@index([companyId, startDate])
  @@index([status])
}

// ── Phase 6.1 — الفترة المحاسبية (شهرية) ─────────────────────────────────────
// الهوية الآلية = ordinal/code داخل السنة؛ أسماء الأشهر العربية تسمية عرض فقط.
// ربع/نصف/YTD/سنوي لا تُخزَّن إطلاقًا — تُشتق لاحقًا (قرار معماري 6.0).
model FiscalPeriod {
  id                  String   @id @default(cuid())
  fiscalYearId        String
  fiscalYear          FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  ordinal             Int                      // 1..N — ترتيب آلي (أساس المقارنة الترتيبية لاحقًا)
  code                String                   // مشتق حتمي من فترة البداية "YYYY-MM"
  startDate           String                   // date-only
  endDate             String                   // date-only
  status              String   @default("OPEN") // OPEN | CLOSED
  zeroActivityDeclared Boolean @default(false) // إعلان «لا حركة» صريح من المشغّل
  displayLabel        String   @default("")    // عرض عربي فقط — ليس هوية

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  reports             Report[]

  @@unique([fiscalYearId, ordinal])
  @@index([fiscalYearId])
  @@index([startDate, endDate])
  @@index([status])
}

// ── Phase 6.1 — سياسة إقفال الشركة (قائمة مكوّنات مطلوبة) ────────────────────
// المكوّنات المسموحة أوليًا: TRIAL_BALANCE | INCOME_STATEMENT | BALANCE_SHEET
// (سجل موسّع في src/lib/closing-policy.ts). طباعة القوائم المالية نفسها لا تُبنى
// في 6.1 — التقييم يُبلغ المكوّنات كغير متاحة (بلا أي بيانات اعتماد مُختلقة).
// Restrict: سياسة قائمة تمنع حذف الشركة (شركة عليها سياسة = ليست فارغة).
model CompanyClosingPolicy {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requiredComponents String   @default("[]")  // JSON array من الأكواد الموثقة فقط
  updatedById        String?
  updatedByName      String   @default("")    // snapshot آخر مُحدِّث (نمط المشروع)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ── Workflow History (append-only) ──
// المرجع التاريخي الكامل لدورات اعتماد كل تقرير — لا توجد أي API تعديل/حذف له.
// كل انتقال workflow يكتب صفًا هنا في نفس المعاملة مع تحديث التقرير وAuditLog.
// بلا FK مع User (نفس مبرر AuditLog) + username snapshot.
model WorkflowHistory {
  id             String   @id @default(cuid())
  reportId       String
  cycle          Int                  // رقم الدورة التي وقع فيها الحدث
  action         String               // CREATED | SUBMITTED | RESUBMITTED | REVIEW_STARTED | RETURNED | APPROVED | REOPENED | RESUMED_EDIT | ASSIGNMENT_CHANGED
  fromStatus     String   @default("") // "" لأحداث الإنشاء/الإسناد الأول
  toStatus       String   @default("")
  actorId        String?              // من نفّذ الحدث (null للنظامي)
  actorUsername  String   @default("") // snapshot
  reason         String   @default("") // إلزامي لـ RETURNED/REOPENED
  comment        String   @default("") // اختياري لأي حدث
  // JSON صغير: snapshot أدوار التقرير لحظة الحدث (preparedBy/reviewedBy/approvedBy
  // بالمعرفات والأسماء والأوقات) — يكفي لإعادة بناء الدورة كاملة حتى لو تغيرت حقول Report
  roleSnapshot   String   @default("{}")
  createdAt      DateTime @default(now())

  @@index([reportId, createdAt])
  @@index([reportId, cycle])
  @@index([action])
}

// ── Audit Trail (append-only) ──
// سجل رقابي غير قابل للتعديل أو الحذف عبر أي API (المدير لديه View/Export فقط).
// لا توجد علاقة FK مع User عمدًا: يجب أن يبقى السجل قائمًا حتى بعد حذف المستخدم،
// و username محفوظ كـ snapshot لحظة العملية. كما أن غياب العلاقة يبقي المخطط
// متوافقًا مباشرة مع PostgreSQL مستقبلًا.
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?  // من نفّذ العملية (null للأحداث النظامية/المجهولة)
  username    String   @default("") // snapshot وقت العملية
  action      String   // كود ثابت من src/lib/audit-actions.ts
  entityType  String   // "Report" | "Group" | "User" | "Auth"
  entityId    String?  // معرّف الكيان المستهدف
  description String   @default("")
  beforeData  String   @default("{}") // JSON: الحقول المتغيرة قبل التعديل فقط (بعد Sanitize)
  afterData   String   @default("{}") // JSON: الحقول المتغيرة بعد التعديل فقط (بعد Sanitize)
  metadata    String   @default("{}") // JSON: سياق إضافي (أحجام، أسباب، حقول متغيرة...)
  ipAddress   String?  // best-effort عبر X-Forwarded-For من البوابة
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
}

// ══════════════════════════════════════════════════════════════════════════════
// Phase 6.2A — بنية القوائم المالية وقواعد طبيعة الحسابات (مستعادة من DDL الترحيل)
// RECOVERY NOTE: schema.prisma الأصلي لـ 6.2 فُقد مع الجلسة؛ أُعيد بناء هذا الملف من
// (1) سكيما حزمة 6.1 المعتمدة + (2) migration.sql للترحيلات 6.2A/6.2B حرفيًا.
// ══════════════════════════════════════════════════════════════════════════════

// ── بنود القوائم المالية (32 بندًا نظاميًا) — شجرة عبر parentId ────────────────
model FinancialStatementLine {
  id             String   @id @default(cuid())
  code           String   @unique           // هوية آلية (مثل BS-ASSETS)
  nameAr         String                     // الاسم المعروض بالعربية
  nameEn         String?                    // اختياري
  statementType  String                     // PNL | SFP | OCI — نوع القائمة
  parentId       String?
  displayOrder   Int      @default(0)
  isSubtotal     Boolean  @default(false)
  isActive       Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent   FinancialStatementLine?  @relation("FSLTree", fields: [parentId], references: [id], onDelete: Restrict)
  children FinancialStatementLine[] @relation("FSLTree")

  natureRules         AccountNatureRule[]
  mappingOverrides    AccountMappingOverride[]

  @@index([statementType, displayOrder])
  @@index([parentId])
}

// ── قواعد طبيعة الحسابات: جذور نظامية (companyId=null) + بادئات الشركات ────────
// resolver: ACCOUNT_OVERRIDE → COMPANY_PREFIX → SYSTEM_ROOT
model AccountNatureRule {
  id                  String   @id @default(cuid())
  companyId           String?                    // null = جذر نظامي (للقراءة فقط)
  prefix              String                     // أطول بادئة تفوز
  mainCategory        String?                    // ASSET | LIABILITY | EQUITY | EXPENSE | REVENUE
  classification      String?                    // BALANCE | FLOW | null
  aggregationBehavior String                     // سلوك التجميع الزمني
  statementLineId     String?
  source              String   @default("SYSTEM") // SYSTEM | COMPANY
  note                String   @default("")
  isActive            Boolean  @default(true)
  version             Int      @default(1)
  createdById         String?
  createdByName       String   @default("")
  updatedById         String?
  updatedByName       String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company       Company?                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  statementLine FinancialStatementLine? @relation(fields: [statementLineId], references: [id], onDelete: SetNull)

  @@unique([companyId, prefix])
  @@index([companyId, isActive])
  @@index([prefix])
  @@index([statementLineId])
}

// ── تجاوزات التصنيف على مستوى الحساب الفردي (تفوز على كل البادئات) ─────────────
model AccountMappingOverride {
  id                  String   @id @default(cuid())
  companyId           String
  accountCode         String                     // كود الحساب الكامل
  classification      String                     // BALANCE | FLOW
  aggregationBehavior String
  statementLineId     String?
  note                String   @default("")
  isActive            Boolean  @default(true)
  version             Int      @default(1)
  createdById         String?
  createdByName       String   @default("")
  updatedById         String?
  updatedByName       String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company       Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  statementLine FinancialStatementLine? @relation(fields: [statementLineId], references: [id], onDelete: SetNull)

  @@unique([companyId, accountCode])
  @@index([companyId, isActive])
  @@index([accountCode])
  @@index([statementLineId])
}

// ══════════════════════════════════════════════════════════════════════════════
// Phase 6.2B — ميزان المراجعة (BigInt amountMinor كسلاسل JSON + Data Type صريح)
// ══════════════════════════════════════════════════════════════════════════════

// ── استيراد ميزان المراجعة (DRAFT → COMMITTED عبر مسار معتمد) ─────────────────
// Phase 6.3 — Revision Governance: المعتمد لا يُعدّل في مكانه ولا يُحذف؛ أي تغيير
// يمر عبر مسار revision: إنشاء مسودة مراجعة (revisionNumber+1، سبب إلزامي،
// supersedesImportId يشير للمعتمد السابق) → VALIDATE → COMMIT. النسخ المعتمدة
// التاريخية تبقى كاملة وقابلة للتتبع عبر سلسلة supersedesImportId.
model TrialBalanceImport {
  id               String   @id @default(cuid())
  companyId        String
  fiscalYearId     String
  fromDate         String                     // date-only "YYYY-MM-DD"
  toDate           String                     // date-only
  startOrdinal     Int                        // ordinal فترة البداية
  endOrdinal       Int                        // ordinal فترة النهاية
  dataType         String                     // CUMULATIVE_YTD | PERIOD_MOVEMENT
  status           String   @default("DRAFT") // DRAFT | COMMITTED
  // ── Phase 6.3 — حقول حوكمة المراجعات ──
  revisionNumber     Int     @default(1)  // 1 = الاستيراد الأول في سلسلته؛ كل مراجعة تزيد 1
  supersedesImportId String?              // المعتمد السابق الذي تحلّ محلّه هذه النسخة (سلسلة تتبع)
  revisionReason     String  @default("") // سبب إنشاء المراجعة — إلزامي للمراجعات، فارغ للاستيراد الأول
  originalFileName String   @default("")
  fileHash         String   @default("")
  payloadHash      String   @default("")
  totalDebitMinor  BigInt
  totalCreditMinor BigInt
  lineCount        Int
  note             String   @default("")
  version          Int      @default(1)
  createdById      String?
  createdByName    String   @default("")
  updatedById      String?
  updatedByName    String   @default("")
  committedAt      DateTime?
  committedById    String?
  committedByName  String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  lines      TrialBalanceLine[]
  // سلسلة المراجعات: كل نسخة تشير للمعتمد السابق — Restrict يمنع حذف حلقة من السلسلة
  supersedes     TrialBalanceImport?  @relation("TBRevisionChain", fields: [supersedesImportId], references: [id], onDelete: Restrict)
  supersededBy   TrialBalanceImport[] @relation("TBRevisionChain")

  // الهوية داخل السلسلة: نفس الشركة/السنة/المدى/النوع + رقم مراجعة مميز
  // (استبدال القيد القديم الذي كان يمنع أي نسخة ثانية لنفس المدى)
  @@unique([companyId, fiscalYearId, fromDate, toDate, dataType, revisionNumber])
  @@index([companyId])
  @@index([fiscalYearId])
  @@index([companyId, status, revisionNumber])
  @@index([supersedesImportId])
}

// ── سطور الاستيراد (snapshot حتمي للاستيراد — بلا timestamps) ──────────────────
model TrialBalanceLine {
  id                  String  @id @default(cuid())
  importId            String
  rowIndex            Int
  accountCode         String
  accountName         String  @default("")
  debitMinor          BigInt
  creditMinor         BigInt
  netMinor            BigInt
  mappedPrefix        String?   // snapshot نتيجة resolver لحظة الاستيراد
  mappingSource       String?   // ACCOUNT_OVERRIDE | COMPANY_PREFIX | SYSTEM_ROOT | UNMAPPED
  mappingStatus       String?   // FULLY_MAPPED | ROOT_ONLY | NEEDS_DETAILED_CLASSIFICATION | NEEDS_CLASSIFICATION
  mainCategory        String?
  classification      String?
  aggregationBehavior String?
  statementLineCode   String?

  import TrialBalanceImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([accountCode])
}

// ══════════════════════════════════════════════════════════════════════════════
// Phase 6.4A — قائمة التغيرات في حقوق الملكية (Foundation)
// المفاهيم التسعة reporting concepts (ليست أكواد حسابات) قابلة للربط لكل شركة
// عبر بادئات — أطول بادئة تفوز — مستقلة تمامًا عن خريطة القوائم المالية 6.2A.
// ══════════════════════════════════════════════════════════════════════════════

model EquityComponentMapping {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  componentCode String                 // من EQUITY_COMPONENTS (lib/equity.ts) — ليس كود حساب
  prefix        String                 // أطول بادئة تفوز
  note          String   @default("")
  isActive      Boolean  @default(true)
  version       Int      @default(1)
  createdById   String?
  createdByName String   @default("")
  updatedById   String?
  updatedByName String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, prefix])
  @@index([companyId, isActive])
  @@index([componentCode])
}

// ══════════════════════════════════════════════════════════════════════════════
// Phase 6.4B — IAS 7 قائمة التدفقات النقدية (Foundation)
// خريطة مستقلة كلية عن Financial Statement Mapping: بند بذرة نظامي مرن +
// ربط بادئات لكل شركة + تجاوز على مستوى الحساب.
// resolver: ACCOUNT_OVERRIDE → LONGEST PREFIX → UNCLASSIFIED (فشل مغلق).
// ══════════════════════════════════════════════════════════════════════════════

model CashFlowStatementLine {
  id           String  @id @default(cuid())
  code         String  @unique
  nameAr       String
  nameEn       String?
  activity     String              // OPERATING | INVESTING | FINANCING | CASH_AND_CASH_EQUIVALENTS
  isAdjustment Boolean @default(false) // تسوية غير نقدية ضمن الطريقة غير المباشرة (إشارة +net)
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
  version      Int     @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mappings         CashFlowMapping[]
  accountOverrides CashFlowAccountOverride[]

  @@index([activity, displayOrder])
}

model CashFlowMapping {
  id            String   @id @default(cuid())
  companyId     String?                // null = ربط نظامي مقترح (للقراءة — لا يفرض نفسه)
  company       Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prefix        String
  activity      String                 // OPERATING | INVESTING | FINANCING | CASH_AND_CASH_EQUIVALENTS | NON_CASH | UNCLASSIFIED
  lineId        String?
  line          CashFlowStatementLine? @relation(fields: [lineId], references: [id], onDelete: SetNull)
  source        String   @default("MANUAL")
  note          String   @default("")
  isActive      Boolean  @default(true)
  version       Int      @default(1)
  createdById   String?
  createdByName String   @default("")
  updatedById   String?
  updatedByName String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, prefix])
  @@index([companyId, isActive])
  @@index([prefix])
  @@index([lineId])
}

model CashFlowAccountOverride {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountCode   String                 // كود الحساب الكامل — يفوز على كل البادئات
  activity      String
  lineId        String?
  line          CashFlowStatementLine? @relation(fields: [lineId], references: [id], onDelete: SetNull)
  note          String   @default("")
  isActive      Boolean  @default(true)
  version       Int      @default(1)
  createdById   String?
  createdByName String   @default("")
  updatedById   String?
  updatedByName String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, accountCode])
  @@index([companyId, isActive])
  @@index([accountCode])
  @@index([lineId])
}

// ══════════════════════════════════════════════════════════════════════════════
// Phase 6.5 — أساس الموازنات وفعلي مقابل الموازنة
// الموازنة تُخزن مرة واحدة لكل (شركة، سنة مالية، نسخة، سيناريو) — وليس لكل تقرير.
// سير العمل: DRAFT → SUBMITTED → APPROVED → LOCKED (نهائي غير قابل للتعديل).
// البنود على مستوى بنود القوائم المالية (reporting lines) + فترة مخصصة — BigInt minor.
// ══════════════════════════════════════════════════════════════════════════════

model Budget {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  fiscalYearId   String
  fiscalYear     FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  versionNumber  Int      @default(1)
  status         String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | LOCKED
  budgetType     String                     // ANNUAL | MONTHLY | QUARTERLY | SEMI_ANNUAL
  scenario       String   @default("BASE")  // BASE | CONSERVATIVE | OPTIMISTIC — وسم لا سياسة
  name           String   @default("")
  note           String   @default("")
  revisionReason String   @default("")      // سبب إنشاء النسخة الجديدة
  supersedesBudgetId String?
  version        Int      @default(1)
  createdById    String?
  createdByName  String   @default("")
  updatedById    String?
  updatedByName  String   @default("")
  submittedById  String?
  submittedByName String  @default("")
  submittedAt    DateTime?
  approvedById   String?
  approvedByName String   @default("")
  approvedAt     DateTime?
  lockedById     String?
  lockedByName   String   @default("")
  lockedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines BudgetLine[]
  supersedes Budget?   @relation("BudgetRevisionChain", fields: [supersedesBudgetId], references: [id], onDelete: Restrict)
  supersededBy Budget[] @relation("BudgetRevisionChain")

  // فترة بداية/نهاية تغطية الموازنة (ordinals) — ANNUAL = 1..periodCount
  startOrdinal Int @default(1)
  endOrdinal   Int @default(12)

  @@unique([companyId, fiscalYearId, versionNumber, scenario])
  @@index([companyId, fiscalYearId, status])
  @@index([status])
  @@index([supersedesBudgetId])
}

model BudgetLine {
  id                String  @id @default(cuid())
  budgetId          String
  budget            Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  statementLineCode String                     // بند القائمة المالية — ليس كود حساب
  fiscalPeriodId    String?                    // الفترة المخصصة (null = مبلغ سنوي غير موزع)
  amountMinor       BigInt
  note              String  @default("")

  @@unique([budgetId, statementLineCode, fiscalPeriodId])
  @@index([budgetId])
  @@index([statementLineCode])
}

// ══════════════════════════════════════════════════════════════════════════════
// Phase 6.6 — أساس التوحيد والتقرير الجماعي المبدئي (PRELIMINARY)
// كل شركة تحتفظ بدليلها وبنودها؛ الربط الجماعي على مستوى بند القائمة للشركة →
// البند الجماعي (لا اشتراط تطابق أكواد الحسابات). Eliminations/Adjustments
// قيود يدوية متوازنة (journal) بتدقيق — لا توحيد IFRS كامل في هذه المرحلة.
// ══════════════════════════════════════════════════════════════════════════════

model ConsolidationGroup {
  id            String   @id @default(cuid())
  code          String   @unique
  nameAr        String
  status        String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdBy     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships        GroupCompanyMembership[]
  reportingLines     GroupReportingLine[]
  groupMappings      GroupReportingMapping[]
  adjustments        ConsolidationAdjustment[]

  @@index([status])
}

model GroupCompanyMembership {
  id                  String   @id @default(cuid())
  groupId             String
  group               ConsolidationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  companyId           String
  company             Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  effectiveFrom       String                        // date-only
  effectiveTo         String?                       // null = مفتوحة
  ownershipPercentage Int?                          // أساس فقط (0-100) — بلا محرك ملكية معقد
  note                String   @default("")

  @@unique([groupId, companyId, effectiveFrom])
  @@index([groupId])
  @@index([companyId])
}

model GroupReportingLine {
  id            String  @id @default(cuid())
  groupId       String
  group         ConsolidationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  code          String                        // هوية داخل المجموعة
  nameAr        String
  statementType String                        // PROFIT_OR_LOSS | STATEMENT_OF_FINANCIAL_POSITION
  displayOrder  Int     @default(0)
  isActive      Boolean @default(true)

  mappings      GroupReportingMapping[]
  adjustmentLines AdjustmentLine[]

  @@unique([groupId, code])
  @@index([groupId, statementType])
}

model GroupReportingMapping {
  id             String  @id @default(cuid())
  groupId        String
  group          ConsolidationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyLineCode String                     // بند قائمة الشركة (مثل PNL-REVENUE)
  groupLineId    String
  groupLine      GroupReportingLine @relation(fields: [groupLineId], references: [id], onDelete: Cascade)

  @@unique([groupId, companyId, companyLineCode])
  @@index([companyId, companyLineCode])
  @@index([groupLineId])
}

// قيد يدوي متوازن (journal) — ADJUSTMENT | ELIMINATION (بنوعه: تعريفات بين الشركات)
model ConsolidationAdjustment {
  id              String   @id @default(cuid())
  groupId         String
  group           ConsolidationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  kind            String   @default("ADJUSTMENT") // ADJUSTMENT | ELIMINATION
  eliminationType String?  // INTERCOMPANY_AR_AP | INTERCOMPANY_SALES_PURCHASES | INTERCOMPANY_LOANS | INTERCOMPANY_DIVIDENDS | OTHER
  fiscalYearId    String?                       // سياق الفترة (سنة الشركة المرجعية للمجموعة)
  startDate       String                        // date-only — تغطية القيد
  endDate         String
  reason          String                        // إلزامي
  status          String   @default("DRAFT")    // DRAFT | POSTED — POSTED حصرًا يدخل الإجماليات
  preparedBy      String   @default("")
  postedBy        String   @default("")
  postedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines AdjustmentLine[]

  @@index([groupId, status])
  @@index([groupId, startDate, endDate])
}

model AdjustmentLine {
  id           String  @id @default(cuid())
  adjustmentId String
  adjustment   ConsolidationAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  groupLineId  String
  groupLine    GroupReportingLine @relation(fields: [groupLineId], references: [id], onDelete: Restrict)
  debitMinor   BigInt
  creditMinor  BigInt

  @@index([adjustmentId])
  @@index([groupLineId])
}

// ── Phase 6.10 — أعمار الديون والتحصيل (Receivables Aging & Collections) ─────
// إضافي حصرًا: 7 جداول جديدة + فهارسها. المال = BigInt وحدات صغرى، والتواريخ نص
// بتاريخ فقط "YYYY-MM-DD" (اصطلاح TrialBalance). لا تعديل على أي جدول قائم.

model AgingBucketConfig {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code      String
  labelAr   String
  labelEn   String
  fromDays  Int?
  toDays    Int?
  isNotDue  Boolean @default(false)
  order     Int

  @@unique([companyId, code])
  @@index([companyId])
}

model AgingInsightRule {
  id            String  @id @default(cuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code          String
  enabled       Boolean @default(true)
  thresholdBp   Int?
  thresholdDays Int?
  thresholdCount Int?
  severity      String  @default("ATTENTION")

  @@unique([companyId, code])
  @@index([companyId])
}

model ReceivablesAccountMapping {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountCode String
  label       String  @default("")

  @@unique([companyId, accountCode])
  @@index([companyId])
}

model AgingImport {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  fileName      String
  fileType      String
  fileSize      Int
  fileSha256    String
  asOfDate      String
  periodLabel   String   @default("")
  status        String   @default("READY")
  mappingSource String
  mappingJson   String
  rowCount      Int
  validRowCount Int
  warningCount  Int
  errorsJson    String   @default("[]")
  createdById   String
  createdByName String
  createdAt     DateTime @default(now())

  rows      AgingRow[]
  snapshots AgingSnapshot[]

  @@index([companyId, createdAt])
}

model AgingRow {
  id                       String  @id @default(cuid())
  importId                 String
  import                   AgingImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  rowIndex                 Int
  customerCode             String?
  customerName             String?
  customerKey              String
  outstandingBalanceMinor  BigInt?
  invoiceNumber            String?
  invoiceDate              String?
  invoiceAmountMinor       BigInt?
  dueDate                  String?
  ageDays                  Int?
  lastSaleDate             String?
  lastSaleAmountMinor      BigInt?
  lastCollectionDate       String?
  lastCollectionAmountMinor BigInt?
  creditLimitMinor         BigInt?
  guaranteeOrInsurance     String?
  salesperson              String?
  responsiblePerson        String?
  notes                    String?
  flagsJson                String  @default("[]")
  warningsJson             String  @default("[]")

  @@index([importId])
  @@index([customerKey])
}

model AgingSnapshot {
  id                   String   @id @default(cuid())
  companyId            String
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  importId             String
  import               AgingImport @relation(fields: [importId], references: [id], onDelete: Restrict)
  asOfDate             String
  periodLabel          String   @default("")
  status               String   @default("DRAFT")
  currency             String   @default("")
  totalsJson           String
  bucketTotalsJson     String
  reconciliationStatus String
  reconciliationJson   String   @default("{}")
  insightsJson         String   @default("[]")
  riskJson             String   @default("[]")
  createdById          String
  createdByName        String
  approvedById         String?
  approvedByName       String?
  approvedAt           DateTime?
  createdAt            DateTime @default(now())

  rows AgingSnapshotRow[]

  @@index([companyId, asOfDate])
  @@index([companyId, status])
}

model AgingSnapshotRow {
  id           String  @id @default(cuid())
  snapshotId   String
  snapshot     AgingSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  customerKey  String
  customerCode String?
  customerName String?
  balanceMinor BigInt
  bucketCode   String
  ageDays      Int?
  basis        String?

  @@index([snapshotId])
  @@index([snapshotId, bucketCode])
}
